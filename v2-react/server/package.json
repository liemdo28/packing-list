{
  "name": "restaurant-operation-system-server",
  "version": "1.0.0",
  "description": "Restaurant Operation System - Store Transfer Management API",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "seed": "node src/seeders/seed.js",
    "seed:prod": "node src/seeders/seed-prod.js",
    "migrate": "node src/index.js --migrate",
    "stress:smoke":        "k6 run ../../stress/k6/smoke.js",
    "stress:auth":         "k6 run ../../stress/k6/auth-load.js",
    "stress:flow":        "k6 run ../../stress/k6/order-flow.js",
    "stress:concurrency": "k6 run ../../stress/k6/same-order-concurrency.js",
    "stress:summary":      "k6 run ../../stress/k6/summary-load.js",
    "stress:export":       "k6 run ../../stress/k6/export-load.js",
    "stress:soak":         "k6 run ../../stress/k6/soak-mixed.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.6.5",
    "pdfkit": "^0.14.0",
    "sequelize": "^6.35.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  }
}
