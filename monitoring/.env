APP_ENV=development

# Telegram alert bot (optional — set real token to enable)
ALERT_TELEGRAM_TOKEN=
ALERT_TELEGRAM_CHAT_ID=

# Email alerts (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# Backend to monitor
API_HEALTH_URL=http://localhost:3001/health
API_BASE_URL=http://localhost:3001/api

# DB connection (for watchdog + backup)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=packing_list
DB_USER=root
DB_PASS=

# Disk check
DISK_CHECK_PATH=C:
DISK_WARN_PERCENT=80
DISK_CRITICAL_PERCENT=95

# DB restart command (Windows XAMPP)
DB_RESTART_COMMAND=net start MySQL

# Backup
BACKUP_DIR=./backups
MYSQLDUMP_PATH=C:/xampp/mysql/bin/mysqldump
MYSQL_PATH=C:/xampp/mysql/bin/mysql
BACKUP_RETENTION_DAYS=30
