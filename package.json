{
  "name": "packing-list-automation",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "build": "cd v2-react/client && npm run build",
    "dev": "cd v2-react/client && npm run dev",
    "build:client": "cd v2-react/client && npm run build",
    "test:smoke": "k6 run stress/k6/smoke.js",
    "test:concurrency": "k6 run stress/k6/same-order-concurrency.js",
    "test:load": "k6 run stress/k6/order-flow.js",
    "test:summary": "k6 run stress/k6/summary-load.js",
    "test:soak": "k6 run stress/k6/soak-mixed.js",
    "test:auth": "k6 run stress/k6/auth-load.js",
    "test:all": "k6 run stress/k6/smoke.js && k6 run stress/k6/same-order-concurrency.js && k6 run stress/k6/order-flow.js && k6 run stress/k6/summary-load.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.1",
    "bcryptjs": "^2.4.3",
    "jest": "^30.0.5",
    "mysql2": "^3.14.2",
    "supertest": "^7.1.4",
    "wait-on": "^8.0.3"
  }
}
