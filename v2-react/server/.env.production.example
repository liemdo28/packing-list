# ============================================================
# Restaurant Operation System — Server Production Env
# ============================================================
# Copy this file to .env and fill in real values.
# .env is in .gitignore — NEVER commit real credentials.
# ============================================================

# --- App ---
NODE_ENV=production
PORT=3001

# --- URLs ---
# Frontend domain (Cloudflare Pages custom domain)
CLIENT_URL=https://packinglist.bakudanramen.com

# --- Database dialect ---
# For Supabase (PostgreSQL): DB_DIALECT=postgres
# For MySQL: DB_DIALECT=mysql
DB_DIALECT=postgres

# --- Database (Supabase) ---
# Found in: Supabase Dashboard → Project Settings → Connection String
DB_HOST=db.YOUR_PROJECT_ID.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASS=YOUR_DB_PASSWORD
DB_SSL=false

# For Supabase local connection (if using the local CLI):
# DB_HOST=127.0.0.1
# DB_PORT=54322
# DB_USER=postgres
# DB_PASS=postgres

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_64_CHAR_HEX_STRING
JWT_EXPIRES_IN=7d
