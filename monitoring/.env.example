# Backend API
API_BASE_URL=https://api.bakudanramen.com
API_HEALTH_URL=https://api.bakudanramen.com/health

# Database (same as backend — fill in real creds)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=packing_list_prod
DB_USER=monitor_user
DB_PASSWORD=

# Admin credentials for smoke flow
SMOKE_ADMIN_USERNAME=admin
SMOKE_ADMIN_PASSWORD=

# Full-workflow smoke test accounts (b1 creates, b2 receives)
SMOKE_B1_USERNAME=user_b1
SMOKE_B1_PASSWORD=
SMOKE_B2_USERNAME=user_b2
SMOKE_B2_PASSWORD=

# Telegram alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# Email alerts (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_TO=admin@bakudanramen.com

# Backup
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=30
MYSQLDUMP_PATH=mysqldump

# Disk check path (Linux: /)
DISK_CHECK_PATH=/
DISK_WARN_PERCENT=80
DISK_CRITICAL_PERCENT=95

# DB watchdog
DB_RESTART_COMMAND=systemctl restart mysql
DB_FAIL_THRESHOLD=3

# Environment label shown in alerts
APP_ENV=production
