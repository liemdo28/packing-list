# ============================================================
# Restaurant Operation System — Server Production Env
# ============================================================
# Copy this file to .env and fill in real values.
# .env is in .gitignore — NEVER commit real credentials.
# ============================================================

# --- App ---
NODE_ENV=production
PORT=3001

# --- URLs ---
# Full URL of the frontend (Cloudflare Pages)
CLIENT_URL=https://app.yourdomain.com

# --- Database ---
DB_HOST=your-db-host.example.com
DB_PORT=3306
DB_NAME=packing_list_prod
DB_USER=packing_app
DB_PASS=your_strong_db_password_here
DB_SSL=false

# For managed DB with SSL (e.g., PlanetScale, Railway, AWS RDS):
# DB_SSL=true

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_64_CHAR_HEX_STRING
JWT_EXPIRES_IN=7d

# --- Optional: File Uploads ---
# UPLOAD_DIR=/var/uploads/packing-list

# --- Optional: Rate Limiting ---
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX=100
