# ============================================================
# Restaurant Operation System — Client Production Env
# ============================================================
# Copy this file to .env.production (for local preview)
# OR set these in Cloudflare Pages → Settings → Environment Variables
# .env is in .gitignore — NEVER commit real values.
# ============================================================

# API base URL — must match api.yourdomain.com (Cloudflare Tunnel)
VITE_API_BASE_URL=https://api.yourdomain.com/api

# App URL — used for OAuth redirects, etc.
VITE_APP_URL=https://app.yourdomain.com
