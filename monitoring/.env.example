# Backend API
API_BASE_URL=https://your-api-domain.com
API_HEALTH_URL=https://your-api-domain.com/health

# Database (same as backend)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=packing_list
DB_USER=monitor_user
DB_PASSWORD=

# Admin credentials for smoke flow
SMOKE_ADMIN_USERNAME=admin
SMOKE_ADMIN_PASSWORD=

# Telegram alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# Email alerts (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_TO=admin@yourdomain.com

# Backup
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=30
MYSQLDUMP_PATH=mysqldump

# Disk check path (Windows: C:, Linux: /)
DISK_CHECK_PATH=C:
DISK_WARN_PERCENT=80
DISK_CRITICAL_PERCENT=95

# DB watchdog
DB_RESTART_COMMAND=net stop mysql80 && net start mysql80
DB_FAIL_THRESHOLD=3

# Environment label shown in alerts
APP_ENV=production
